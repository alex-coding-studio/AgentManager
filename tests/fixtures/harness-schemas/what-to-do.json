          "pattern": "\\S"
        },
        "repositorySummary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["markdown", "evidencePaths"],
          "properties": {
            "markdown": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000,
              "pattern": "\\S"
            },
            "evidencePaths": {
              "type": "array",
              "maxItems": 200,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000,
                "pattern": "\\S"
              },
              "minItems": 1
            }
          }
        },
        "reviewedEvidence": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "reason"],
            "properties": {
              "path": {
                "type": "string",
