{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "What to Do Harness Result",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "harness",
        "request",
        "responseMarkdown",
        "repositorySummary",
        "reviewedEvidence",
        "outcome",
        "candidates",
        "sourceClaims"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "harness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "revision"],
          "properties": {
            "id": { "const": "praxis.what-to-do" },
            "revision": { "const": 3 }
          }
        },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sessionId", "requestId", "inputFingerprint"],
          "properties": {
            "sessionId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000,
              "pattern": "\\S"
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000,
              "pattern": "\\S"
            },
            "inputFingerprint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 20000,
              "pattern": "\\S"
            }
          }
        },
        "responseMarkdown": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000,
          "pattern": "\\S"
        },
        "repositorySummary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["markdown", "evidencePaths"],
          "properties": {
            "markdown": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100000,
              "pattern": "\\S"
            },
            "evidencePaths": {
              "type": "array",
              "maxItems": 200,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000,
                "pattern": "\\S"
              },
              "minItems": 1
            }
          }
        },
        "reviewedEvidence": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "reason"],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000,
                "pattern": "\\S"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000,
                "pattern": "\\S"
              }
            }
          }
        },
        "outcome": { "const": "map-proposal" },
        "candidates": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidateId",
              "revision",
              "title",
              "summary",
              "outcome",
              "includedScope",
              "excludedScope",
              "productRules",
              "domainImpact",
              "requiredExperienceStates",
              "repositoryConstraints",
              "dependsOn",
              "acceptanceCriteria",
              "validationExpectations",
              "sourceClaimIds",
              "openDecisions",
              "deliveryStrategy"
            ],
            "properties": {
              "candidateId": {
                "type": "string",
                "pattern": "^CANDIDATE-(?:[0-9]{4,}|[0-9a-f]{8,32})$"
              },
              "revision": { "type": "integer", "minimum": 1 },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "\\S"
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600,
                "pattern": "\\S"
              },
              "outcome": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000,
                "pattern": "\\S"
              },
              "includedScope": {
                "type": "array",
                "maxItems": 200,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000,
                  "pattern": "\\S"
                },
                "minItems": 1
              },
              "excludedScope": {
                "type": "array",
                "maxItems": 200,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000,
                  "pattern": "\\S"
                }
              },
              "productRules": {
                "type": "array",
                "maxItems": 200,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000,
                  "pattern": "\\S"
                },
                "minItems": 1
              },
              "domainImpact": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "reason", "evidencePaths"],
                "properties": {
                  "kind": {
                    "enum": ["none", "reuse", "change", "add", "uncertain"]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000,
                    "pattern": "\\S"
                  },
                  "evidencePaths": {
                    "type": "array",
                    "maxItems": 200,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20000,
                      "pattern": "\\S"
                    }
                  }
                }
              },
              "requiredExperienceStates": {
                "type": "array",
                "maxItems": 200,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000,
                  "pattern": "\\S"
                }
              },
              "repositoryConstraints": {
                "type": "array",
                "maxItems": 200,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000,
                  "pattern": "\\S"
                }
              },
              "dependsOn": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^CANDIDATE-(?:[0-9]{4,}|[0-9a-f]{8,32})$"
                }
              },
              "acceptanceCriteria": {
                "type": "array",
                "minItems": 1,
                "maxItems": 60,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "condition", "passCondition", "evidence"],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20000,
                      "pattern": "\\S"
                    },
                    "condition": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20000,
                      "pattern": "\\S"
                    },
                    "passCondition": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20000,
                      "pattern": "\\S"
                    },
                    "evidence": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20000,
                      "pattern": "\\S"
                    }
                  }
                }
              },
              "validationExpectations": {
                "type": "array",
                "maxItems": 200,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000,
                  "pattern": "\\S"
                },
                "minItems": 1
              },
              "sourceClaimIds": {
                "type": "array",
                "maxItems": 200,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000,
                  "pattern": "\\S"
                },
                "minItems": 1
              },
              "openDecisions": {
                "type": "array",
                "maxItems": 200,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000,
                  "pattern": "\\S"
                }
              },
              "deliveryStrategy": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "reason"],
                "properties": {
                  "kind": {
                    "enum": [
                      "foundation-first",
                      "experience-first",
                      "vertical-slice",
                      "risk-first"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000,
                    "pattern": "\\S"
                  }
                }
              }
            }
          }
        },
        "sourceClaims": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claimId",
              "sourcePath",
              "sourceSha256",
              "anchor",
              "summary",
              "disposition",
              "contractCandidateIds",
              "exclusionReason",
              "exclusionAuthority"
            ],
            "properties": {
              "claimId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000,
                "pattern": "\\S"
              },
              "sourcePath": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000,
                "pattern": "\\S"
              },
              "sourceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "anchor": {
                "type": "string",
                "minLength": 8,
                "maxLength": 2000,
                "pattern": "\\S"
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000,
                "pattern": "\\S"
              },
              "disposition": { "enum": ["in-scope", "out-of-scope"] },
              "contractCandidateIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^CANDIDATE-(?:[0-9]{4,}|[0-9a-f]{8,32})$"
                }
              },
              "exclusionReason": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000,
                    "pattern": "\\S"
                  },
                  { "type": "null" }
                ]
              },
              "exclusionAuthority": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["userInputPath", "userInputSha256", "anchor"],
                    "properties": {
                      "userInputPath": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 20000,
                        "pattern": "\\S"
                      },
                      "userInputSha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "anchor": {
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 2000,
                        "pattern": "\\S"
                      }
                    }
                  },
                  { "type": "null" }
                ]
              }
            }
          }
        },
        "recomposition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["effects"],
          "properties": {
            "effects": {
              "type": "array",
              "minItems": 1,
              "maxItems": 400,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "from", "to"],
                "properties": {
                  "kind": {
                    "enum": [
                      "retain",
                      "replace",
                      "split",
                      "merge",
                      "add",
                      "remove"
                    ]
                  },
                  "from": {
                    "type": "array",
                    "maxItems": 200,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20000,
                      "pattern": "\\S"
                    }
                  },
                  "to": {
                    "type": "array",
                    "maxItems": 200,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20000,
                      "pattern": "\\S"
                    }
                  }
                }
              }
            }
          }
        },
        "sourceClaimUpdates": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claimId",
              "disposition",
              "contractCandidateIds",
              "exclusionReason",
              "exclusionAuthority"
            ],
            "properties": {
              "claimId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20000,
                "pattern": "\\S"
              },
              "disposition": { "enum": ["in-scope", "out-of-scope"] },
              "contractCandidateIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^CANDIDATE-(?:[0-9]{4,}|[0-9a-f]{8,32})$"
                }
              },
              "exclusionReason": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000,
                    "pattern": "\\S"
                  },
                  { "type": "null" }
                ]
              },
              "exclusionAuthority": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["userInputPath", "userInputSha256", "anchor"],
                    "properties": {
                      "userInputPath": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 20000,
                        "pattern": "\\S"
                      },
                      "userInputSha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "anchor": {
                        "type": "string",
                        "minLength": 8,
                        "maxLength": 2000,
                        "pattern": "\\S"
                      }
                    }
                  },
                  { "type": "null" }
                ]
              }
            }
          }
        },
        "contractDependencyUpdates": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["candidateId", "dependsOn"],
            "properties": {
              "candidateId": {
                "type": "string",
                "pattern": "^CANDIDATE-(?:[0-9]{4,}|[0-9a-f]{8,32})$"
              },
              "dependsOn": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^CANDIDATE-(?:[0-9]{4,}|[0-9a-f]{8,32})$"
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "harness",
        "request",
        "responseMarkdown",
        "repositorySummary",
