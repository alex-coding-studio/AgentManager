{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decomposition Harness Result",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "harness",
        "request",
        "impactReview",
        "outcome",
        "candidates"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "harness": { "$ref": "#/$defs/harness" },
        "request": { "$ref": "#/$defs/request" },
        "impactReview": { "$ref": "#/$defs/impactReview" },
        "outcome": { "const": "proposal" },
        "candidates": {
          "type": "array",
          "minItems": 0,
          "items": { "$ref": "#/$defs/candidate" }
        },
        "recomposition": { "$ref": "#/$defs/recomposition" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "harness",
        "request",
        "impactReview",
        "outcome",
        "clarification"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "harness": { "$ref": "#/$defs/harness" },
        "request": { "$ref": "#/$defs/request" },
        "impactReview": { "$ref": "#/$defs/impactReview" },
        "outcome": { "const": "clarification" },
        "clarification": { "$ref": "#/$defs/clarification" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "harness",
        "request",
        "impactReview",
        "outcome",
        "missingEvidence"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "harness": { "$ref": "#/$defs/harness" },
        "request": { "$ref": "#/$defs/request" },
        "impactReview": { "$ref": "#/$defs/impactReview" },
        "outcome": { "const": "insufficient-evidence" },
        "missingEvidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "minItems": 1
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "harness",
        "request",
        "impactReview",
        "outcome",
        "reason"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "harness": { "$ref": "#/$defs/harness" },
        "request": { "$ref": "#/$defs/request" },
        "impactReview": { "$ref": "#/$defs/impactReview" },
        "outcome": { "const": "no-change" },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 600
        }
      }
    }
  ],
  "$defs": {
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": { "const": "praxis.task-decomposition" },
        "revision": { "const": 8 }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "requestId", "inputFingerprint"],
      "properties": {
        "sessionId": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "requestId": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "inputFingerprint": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "impactReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewedNodeIds", "affectedNodeIds", "notes"],
      "properties": {
        "reviewedNodeIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^NODE-[0-9a-f]{8,32}$" }
        },
        "affectedNodeIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^NODE-[0-9a-f]{8,32}$" }
        },
        "notes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 80
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 500
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "revision",
        "type",
        "title",
        "summary",
        "derivedFrom",
        "dependsOn",
        "resources",
        "typeTemplateRef",
        "metadata",
        "presentation",
        "assumptions"
      ],
      "properties": {
        "candidateId": {
          "type": "string",
          "pattern": "^CANDIDATE-(?:[0-9]{4,}|[0-9a-f]{8,32})$"
        },
        "revision": { "type": "integer", "minimum": 1 },
        "type": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 160
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 600
        },
        "derivedFrom": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^NODE-[0-9a-f]{8,32}$" },
          "minItems": 1
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "oneOf": [
              { "type": "string", "pattern": "^NODE-[0-9a-f]{8,32}$" },
              {
                "type": "string",
                "pattern": "^CANDIDATE-(?:[0-9]{4,}|[0-9a-f]{8,32})$"
              }
            ]
          }
        },
        "resources": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/resource" }
        },
        "typeTemplateRef": {
          "oneOf": [
            { "type": "string", "pattern": "^NODE-[0-9a-f]{8,32}$" },
            { "type": "null" }
          ]
        },
        "metadata": { "type": "object" },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
          }
        },
        "assumptions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    },
    "recomposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effects"],
      "properties": {
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "from", "to"],
            "properties": {
              "kind": {
                "enum": ["retain", "replace", "split", "merge", "add", "remove"]
              },
              "from": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
              },
              "to": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
              }
            }
          }
        }
      }
    },
    "clarification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "options"],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 600
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "effect", "recommended"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "maxLength": 80
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "maxLength": 160
              },
              "effect": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "maxLength": 600
              },
              "recommended": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
