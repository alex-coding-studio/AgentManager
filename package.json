{
  "name": "agent-manager",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "agent-manager": "./bin/agent-manager.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cli": "node ./bin/agent-manager.mjs",
    "lint": "oxlint .",
    "format": "oxfmt",
    "test:graph": "node --experimental-strip-types --test tests/task-graph-layout.test.ts tests/task-graph-rules.test.ts tests/graph-identity.test.ts tests/uuid-alias-migration.test.mjs tests/graph-node-card.test.ts tests/goal-picker-graph.test.ts",
    "test:dependency-audit": "node --experimental-strip-types --test tests/runtime-dependency-audit.test.ts",
    "test:planning-paths": "node --experimental-strip-types --test tests/planning-paths.test.ts",
    "test:canvas-frame": "node --experimental-strip-types --import ./tests/helpers/register-alias.mjs --test tests/canvas-node-card-frame.test.ts",
    "test:harness": "node --experimental-strip-types --test tests/task-decomposition-harness.test.ts",
    "test:runs": "node --experimental-strip-types --test tests/agent-runtime-driver.test.ts tests/card-host-operations.test.ts tests/system-validation-runner.test.ts tests/system-validation-fix-agent.test.ts tests/local-agent-skills.test.ts tests/local-agent-transport.test.ts tests/task-decomposition-context-workspace.test.ts tests/task-decomposition-dependencies.test.ts tests/task-decomposition-runs.test.ts tests/dev-origins.test.ts",
    "test:whats-next": "node --experimental-strip-types --test tests/whats-next-harness.test.ts tests/whats-next-redo.test.mjs tests/whats-next-context.test.ts tests/latest-response.test.ts",
    "test:markdown": "node --experimental-strip-types --test tests/markdown-feedback-position.test.ts tests/browser-uuid.test.ts",
    "test:settings": "node --experimental-strip-types --test tests/app-settings.test.ts",
    "test:boundary": "node --experimental-strip-types --import ./tests/helpers/register-alias.mjs --test tests/api-request-boundary.test.ts",
    "test:registry": "node --experimental-strip-types --test tests/project-registry-atomicity.test.ts",
    "test:api-errors": "node --experimental-strip-types --import ./tests/helpers/register-alias.mjs --test tests/api-error-safety.test.ts",
    "test": "npm run test:graph && npm run test:task-graph-failures && npm run test:dependency-audit && npm run test:planning-paths && npm run test:canvas-frame && npm run test:harness && npm run test:runs && npm run test:decomposition-concurrency && npm run test:whats-next && npm run test:markdown && npm run test:settings && npm run test:boundary && npm run test:registry && npm run test:api-errors && npm run test:implementation-demo && npm run test:implementation-harness && npm run test:implementation-planning && npm run test:implementation-execution",
    "test:ci": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "test:implementation-demo": "node --experimental-strip-types --test tests/just-do-it-demo.test.ts",
    "test:implementation-harness": "node --experimental-strip-types --test tests/just-do-it-harness.test.ts",
    "test:implementation-planning": "node --experimental-strip-types --test tests/just-do-it-planning.test.ts tests/local-agent-models.test.ts",
    "test:implementation-execution": "node --experimental-strip-types --test tests/just-do-it-coordination.test.ts tests/just-do-it-checklist.test.ts tests/just-do-it-execution.test.ts tests/github-delivery.test.ts tests/just-do-it-worktree.test.ts",
    "test:coordination-smoke": "node --experimental-strip-types scripts/smoke-coordination.ts",
    "test:simulator-access": "node --experimental-strip-types scripts/smoke-codex-simulator.ts",
    "test:worktree-sandbox": "node --experimental-strip-types scripts/smoke-card-worktree.ts",
    "preview:implementation-harness": "node --experimental-strip-types scripts/preview-just-do-it-harness.ts",
    "typecheck": "tsc --noEmit",
    "test:appserver-code-smoke": "node --experimental-strip-types scripts/smoke-app-server-code.ts",
    "format:check": "oxfmt --check .",
    "audit:runtime-dependencies": "node --experimental-strip-types scripts/audit-runtime-dependencies.ts",
    "test:decomposition-concurrency": "node --experimental-strip-types --experimental-test-module-mocks --test-timeout=20000 --test tests/task-decomposition-acceptance-concurrency.test.ts",
    "test:task-graph-failures": "node --experimental-strip-types --experimental-test-module-mocks --test-timeout=20000 --test tests/task-graph-failure-boundary.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@dagrejs/dagre": "2.0.4",
    "@shadcn/react": "0.3.0",
    "@xyflow/react": "12.11.5",
    "ajv": "8.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "next": "16.3.3",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "4.18.0",
    "simple-icons": "^16.29.0",
    "tailwind-merge": "3.6.0",
    "trash": "10.1.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
